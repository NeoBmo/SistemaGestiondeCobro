# Solo nombres de variables — nunca valores reales. Copia a .env.local (no se commitea).
# Se validan con Zod al iniciar (src/shared/validation/env.ts, F0-T4).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor — nunca al navegador
SUPABASE_SERVICE_ROLE_KEY=
# Cadena de conexión al pooler de Supabase para el driver pg (solo servidor)
DATABASE_URL=
# Dominio reservado para emails sintéticos de usuarios (ADR 0002)
AUTH_SYNTHETIC_EMAIL_DOMAIN=
