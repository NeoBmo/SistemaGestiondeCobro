# Entorno y secretos — nunca se commitean
.env
.env.*
!.env.example

# Sistema operativo
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/
*.swp

# Node / Next.js — se activan de lleno al ejecutar F0 (create-next-app
# genera su propio .gitignore más completo; este cubre el vacío hasta
# entonces, para que el commit de planificación no arrastre basura)
node_modules/
.next/
out/
npm-debug.log*
npm-audit-report.json

# Bitácora local de sesiones de agentes (OpenCode/Codex): rutas y modelos de cada máquina
MEMORY.md

# Logs
*.log

# Next.js / pruebas
*.tsbuildinfo
next-env.d.ts
coverage/
playwright-report/
test-results/
.vercel/

# Artefactos locales de agentes y herramientas
.playwright-mcp/
.worktrees/
