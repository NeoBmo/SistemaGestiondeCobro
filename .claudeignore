# Este archivo reduce ruido/tokens de contexto (node_modules, builds, logs).
# NO es un límite de seguridad: Claude Code puede seguir leyendo un archivo
# listado aquí si se le pide explícitamente. Los secretos (.env*, claves,
# credenciales) se bloquean de verdad en .claude/settings.json
# (permissions.deny), no aquí.

# Dependencias
node_modules/
.pnp
.pnp.js

# Build / output
.next/
out/
dist/
build/
.turbo/
.vercel/

# Variables de entorno y secretos
.env
.env.local
.env.*.local
.env.production
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cobertura y resultados de test
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# Assets estáticos pesados (no necesarios para razonar sobre código)
public/uploads/
public/**/*.mp4
public/**/*.mov
public/**/*.zip
public/**/*.psd

# Supabase local
supabase/.branches/
supabase/.temp/

# Editor / SO
.DS_Store
.vscode/
.idea/
*.swp

# Git
.git/
